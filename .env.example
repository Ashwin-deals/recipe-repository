# CartChef configuration, read by Flask at runtime. Every variable is optional: with none
# set the app runs fully offline with SQLite and the non-AI fallbacks. Copy to .env for
# `flask run`. The React frontend has no build-time settings; never put secrets in VITE_*
# variables, because Vite bakes them into the public JavaScript bundle.

# Port Gunicorn binds to in the container (Cloud Run sets this automatically).
PORT=8080

# --- Core ---
# SQLite file path (relative paths are resolved from the project folder).
DATABASE_PATH=instance/cartchef.db
# Built React app that Flask serves in production (created by `npm run build` in frontend/).
FRONTEND_DIST=frontend/dist
# "production" (default) or "development". Production refuses to start without a strong
# SECRET_KEY. `flask run --debug` counts as development.
APP_ENV=production
# Signs cookies, derives CSRF tokens and salts analytics ids. Required in production: use a long
# random value, e.g. python -c "import secrets; print(secrets.token_hex(32))". In development an
# empty value means a random key is generated once and stored in the database.
SECRET_KEY=
# Give every new account its own copy of 6 starter recipes (1 or 0).
SEED_DEMO_DATA=1

# --- Accounts ---
# Let new people create accounts (1 or 0).
ALLOW_SIGNUPS=1
# How long a sign-in lasts on the server, in days. Without "Keep me signed in" the cookie also
# ends when the browser closes; with it, the session lasts REMEMBER_DAYS.
SESSION_DAYS=7
REMEMBER_DAYS=30
# Mark cookies Secure (HTTPS only). Keep 1 in production; set 0 for local http://localhost.
COOKIE_SECURE=1
# Show a "Try the demo" button that signs in to ONE shared, public demo account (anyone can see
# and change it; it resets daily). Off by default.
DEMO_LOGIN=0
# Sign-in protection: attempts per client, then a lockout after this many wrong passwords per
# email and client, and a short pause after every failure.
LOGIN_RATE_LIMIT=30/15 minutes
SIGNUP_RATE_LIMIT=10/hour
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
AUTH_FAILURE_DELAY_MS=300
# Number of trusted reverse proxies in front of the app so rate limiting sees the real
# client IP and cookies are marked Secure. The Docker image defaults to 1 (Cloud Run);
# use 0 when nothing sits in front of the app.
TRUST_PROXY_HOPS=0
LOG_LEVEL=INFO

# --- Gemini (Snap-a-recipe import, nutrition estimates, substitutions) ---
# Turn every AI feature off with 0; the non-AI fallbacks are used instead.
AI_ENABLED=1
# Model name to call. The app never hardcodes one; check Google's current model list.
GEMINI_MODEL=gemini-2.5-flash
# Option 1 (simplest for local use): a Gemini API key from Google AI Studio.
# Paste it into your own .env (never into this file, never into git, never into VITE_* vars).
GEMINI_API_KEY=
# Set to true if GEMINI_API_KEY is a Vertex AI (Express mode) key rather than an AI Studio key.
GOOGLE_GENAI_USE_VERTEXAI=false
# Option 2: Vertex AI with Application Default Credentials (used when GEMINI_API_KEY is empty).
# Run `gcloud auth application-default login` locally; Cloud Run uses its service account.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Guardrails for AI endpoints (daily caps are counted in the database, per UTC day).
# AI_DAILY_CAP is for everyone together, AI_USER_DAILY_CAP for each account.
AI_DAILY_CAP=300
AI_USER_DAILY_CAP=50
# Per-account rate limit, plus one shared by everyone.
AI_RATE_LIMIT=10/minute
AI_GLOBAL_RATE_LIMIT=60/minute
# Rate limit for the Ask the chef chat.
CHAT_RATE_LIMIT=15/minute
AI_TIMEOUT_SECONDS=30
# Tokens Gemini may spend "thinking" before it answers. 0 (default) is fastest and fine for
# CartChef's short replies; -1 leaves it to the model (needed for models such as 2.5 Pro
# that can't turn thinking off).
GEMINI_THINKING_BUDGET=0

# --- Cloud Storage persistence for the SQLite file ---
GCS_BUCKET=
GCS_DB_OBJECT=cartchef.db
# Seconds to wait after a write before uploading, so a burst of writes is one upload.
GCS_BACKUP_DELAY_SECONDS=2

# --- BigQuery event mirror (needs GOOGLE_CLOUD_PROJECT) ---
BIGQUERY_DATASET=
BIGQUERY_TABLE=events

# --- Insights page: optional https link to a Looker Studio report ---
LOOKER_STUDIO_URL=
