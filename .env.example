# CartChef configuration. Every variable is optional: with none set the app runs
# fully offline with SQLite and the non-AI fallbacks. Copy to .env for `flask run`.

# --- Core ---
# SQLite file path (relative paths are resolved from the project folder).
DATABASE_PATH=instance/cartchef.db
# Session signing key. If empty, a random key is generated once and stored in the database.
SECRET_KEY=
# Seed 6 demo recipes into an empty database (1 or 0).
SEED_DEMO_DATA=1
# Number of trusted reverse proxies in front of the app (set to 1 on Cloud Run) so
# rate limiting sees the real client IP and cookies are marked Secure. 0 = no proxy.
TRUST_PROXY_HOPS=0
LOG_LEVEL=INFO

# --- Gemini on Vertex AI (all three required to turn AI features on) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=
# Guardrails for AI endpoints.
AI_DAILY_CAP=300
AI_RATE_LIMIT=10/minute
AI_TIMEOUT_SECONDS=30

# --- Cloud Storage persistence for the SQLite file ---
GCS_BUCKET=
GCS_DB_OBJECT=cartchef.db

# --- BigQuery event mirror (also needs GOOGLE_CLOUD_PROJECT) ---
BIGQUERY_DATASET=
BIGQUERY_TABLE=events

# --- Insights page: optional https link to a Looker Studio report ---
LOOKER_STUDIO_URL=
